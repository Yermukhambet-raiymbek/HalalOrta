# Environment variables the server reads. Set them in your hosting dashboard
# or shell. The server does not load a .env file itself, and docker compose
# sets its own local values in docker-compose.yml.

# PostgreSQL connection string. Required.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# HTTP port. Default: 8080.
PORT=8080

# Folder with the built frontend. Default: static (the Docker image uses /app/static).
STATIC_DIR=static

# true forces the Secure flag on the session cookie. Set to true in production.
# Default: false (the flag is still set for HTTPS requests via X-Forwarded-Proto).
COOKIE_SECURE=false
